func padded<const N: i32>(arr: Array<i32, N>) -> i32 {
  buf: Array<i32, N + 1> = [];
  i: i32 = 0;
  for (i = 0; i < N; i = i + 1) {
    buf[i] = arr[i];
  }
  buf[N] = 999;
  return buf[N];
}

func checkSizes<const N: i32>(a: Array<i32, N>, b: Array<i32, N * 2>) -> i32 {
  return N;
}

func main() -> i32 {
  arr1: Array<i32, 4> = [1, 2, 3, 4];
  r: i32 = padded(arr1);
  ioPrintln(r);

  double_arr: Array<i32, 8> = [0,0,0,0,0,0,0,0];
  cs: i32 = checkSizes(arr1, double_arr);
  ioPrintln(cs);

  return 0;
}
