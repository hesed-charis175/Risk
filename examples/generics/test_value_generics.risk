generic _Numeric = [i32, f32];

func sumArr<T: _Numeric, const N: i32>(arr: Array<T, N>) -> T {
  total: T = 0;
  i: i32 = 0;
  for (i = 0; i < N; i = i + 1) {
    total = total + arr[i];
  }
  return total;
}

func makeLocal<const N: i32>(arr: Array<i32, N>) -> i32 {
  buf: Array<i32, N> = [];
  count: i32 = 0;
  for (i: i32 = 0; i < N; i = i + 1) {
    count = count + i;
  }
  return count + N;
}

func main() -> i32 {
  arr1: Array<i32, 4> = [1, 2, 3, 4];
  s: i32 = sumArr(arr1);
  ioPrintln(s);

  arr2: Array<f32, 3> = [1.5, 2.5, 3.0];
  s2: f32 = sumArr(arr2);
  ioPrintln(s2);

  m: i32 = makeLocal(arr1);
  ioPrintln(m);

  return 0;
}
