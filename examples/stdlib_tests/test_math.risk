import "test_helpers.risk";

func main() -> i32 {
  ioPrintln("=== math ===");

  checkF64("abs(-5.5)", abs(-5.5), 5.5, 0.0001);
  checkF64("abs(5.5)", abs(5.5), 5.5, 0.0001);
  checkF64("abs(0.0)", abs(0.0), 0.0, 0.0001);

  checkF64("pow(2,10)", pow(2.0, 10.0), 1024.0, 0.0001);
  checkF64("sqrt(9)", sqrt(9.0), 3.0, 0.0001);
  checkF64("sq(4)", sq(4.0), 16.0, 0.0001);
  checkF64("sq(-3)", sq(-3.0), 9.0, 0.0001);
  checkF64("cbrt(27)", cbrt(27.0), 3.0, 0.0001);

  checkF64("mod(10,3)", mod(10.0, 3.0), 1.0, 0.0001);
  checkF64("mod(-7,3)", mod(-7.0, 3.0), -1.0, 0.0001);
  checkF64("mod(7,-3)", mod(7.0, -3.0), 1.0, 0.0001);
  checkF64("mod(-7,-3)", mod(-7.0, -3.0), -1.0, 0.0001);

  checkF64("max(3,7)", max(3.0, 7.0), 7.0, 0.0001);
  checkF64("max(7,3)", max(7.0, 3.0), 7.0, 0.0001);
  checkF64("min(3,7)", min(3.0, 7.0), 3.0, 0.0001);
  checkF64("min(7,3)", min(7.0, 3.0), 3.0, 0.0001);

  checkF64("floor(3.7)", floor(3.7), 3.0, 0.0001);
  checkF64("floor(-3.2)", floor(-3.2), -4.0, 0.0001);
  checkF64("ceil(3.2)", ceil(3.2), 4.0, 0.0001);
  checkF64("ceil(-3.7)", ceil(-3.7), -3.0, 0.0001);
  checkF64("round(3.5)", round(3.5), 4.0, 0.0001);
  checkF64("round(3.4)", round(3.4), 3.0, 0.0001);

  checkF64("exp(0)", exp(0.0), 1.0, 0.0001);
  checkF64("exp2(3)", exp2(3.0), 8.0, 0.0001);
  checkF64("log(exp(1))", log(exp(1.0)), 1.0, 0.0001);
  checkF64("log10(1000)", log10(1000.0), 3.0, 0.0001);
  checkF64("log2(8)", log2(8.0), 3.0, 0.0001);

  checkF64("sin(0)", sin(0.0), 0.0, 0.0001);
  checkF64("cos(0)", cos(0.0), 1.0, 0.0001);
  checkF64("tan(0)", tan(0.0), 0.0, 0.0001);
  checkF64("asin(0)", asin(0.0), 0.0, 0.0001);
  checkF64("acos(1)", acos(1.0), 0.0, 0.0001);
  checkF64("atan(0)", atan(0.0), 0.0, 0.0001);
  checkF64("atan2(0,1)", atan2(0.0, 1.0), 0.0, 0.0001);
  checkF64("sinh(0)", sinh(0.0), 0.0, 0.0001);
  checkF64("cosh(0)", cosh(0.0), 1.0, 0.0001);
  checkF64("tanh(0)", tanh(0.0), 0.0, 0.0001);

  checkF64("degToRad(180)", degToRad(180.0), 3.14159265358979, 0.0001);
  checkF64("radToDeg(pi)", radToDeg(3.14159265358979), 180.0, 0.0001);
  checkF64("degToRad(0)", degToRad(0.0), 0.0, 0.0001);
  checkF64("radToDeg(0)", radToDeg(0.0), 0.0, 0.0001);

  checkBool("isNan(0/0)", isNan(0.0 / 0.0), true);
  checkBool("isNan(5.0)", isNan(5.0), false);
  checkBool("isInf(1/0)", isInf(1.0 / 0.0), true);
  checkBool("isInf(-1/0)", isInf(-1.0 / 0.0), true);
  checkBool("isInf(5.0)", isInf(5.0), false);
  checkBool("isInf(0/0)", isInf(0.0 / 0.0), false);

  return printSummary("math");
}
