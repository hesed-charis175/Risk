import "@core";

extern "__tui_header__/__tui_input__.h" {
    func kbHit() -> i32;
    func kbReadKey() -> i32;
    func rawModeEnter() -> void;
    func rawModeLeave() -> void;
    func flushStdout() -> void;
}

func tuiClear() -> void { ioPrint("\033[2J", "\033[H"); }
func tuiClearLine() -> void { ioPrint("\033[2K"); }
func tuiGoto(row: i32, col: i32) -> void { ioPrint("\033[", row, ";", col, "H"); }
func tuiHideCursor() -> void { ioPrint("\033[?25l"); }
func tuiShowCursor() -> void { ioPrint("\033[?25h"); }
func tuiReset() -> void       { ioPrint("\033[0m"); }
func tuiBold() -> void        { ioPrint("\033[1m"); }
func tuiDim() -> void         { ioPrint("\033[2m"); }
func tuiItalic() -> void      { ioPrint("\033[3m"); }
func tuiUnderline() -> void   { ioPrint("\033[4m"); }
func tuiReverse() -> void     { ioPrint("\033[7m"); }

func tuiEnterAltScreen() -> void { ioPrint("\033[?1049h"); }
func tuiExitAltScreen() -> void  { ioPrint("\033[?1049l"); }
func tuiSaveCursor() -> void      { ioPrint("\033[s"); }
func tuiRestoreCursor() -> void   { ioPrint("\033[u"); }

func COLOR_BLACK() -> i32          { return 0; }
func COLOR_RED() -> i32            { return 1; }
func COLOR_GREEN() -> i32          { return 2; }
func COLOR_YELLOW() -> i32         { return 3; }
func COLOR_BLUE() -> i32           { return 4; }
func COLOR_MAGENTA() -> i32        { return 5; }
func COLOR_CYAN() -> i32           { return 6; }
func COLOR_WHITE() -> i32          { return 7; }
func COLOR_BRIGHT_BLACK() -> i32   { return 8; }
func COLOR_BRIGHT_RED() -> i32     { return 9; }
func COLOR_BRIGHT_GREEN() -> i32   { return 10; }
func COLOR_BRIGHT_YELLOW() -> i32  { return 11; }
func COLOR_BRIGHT_BLUE() -> i32    { return 12; }
func COLOR_BRIGHT_MAGENTA() -> i32 { return 13; }
func COLOR_BRIGHT_CYAN() -> i32    { return 14; }
func COLOR_BRIGHT_WHITE() -> i32   { return 15; }

func COLOR_DEFAULT() -> i32  { return 7; }
