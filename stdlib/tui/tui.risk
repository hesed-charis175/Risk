func bufPutCp(buf: Buffer, row: i32, col: i32,
               cp: i32, fg: i32, bg: i32, attr: i32) -> void {
    tuiBufferSet(buf, row, col, cp, fg, bg, attr);
}


func bufWriteCpsString(buf: Buffer, row: i32, col: i32, cps: Array<string>, fg: i32, bg: i32, attr: i32) -> void {
    cpsInt: Array<i32> = [];
    
    for(i: i32 = 0; i < length(cps); i++) {
    	chars: Array<char> = strToChars(cps[i]);
    	for(j: i32 = 0; j < length(chars); j++) {
    		cpsInt.push(unsafe_cast<i32>(chars[j]));
    	}
    	cpsInt.push(32); cpsInt.push(32);
    }
    if (row < 0)           { return; }
    if (row >= buf.height) { return; }
    i: i32 = 0;
    c: i32 = col;
    while (i < length(cpsInt)) {
        if (c >= buf.width) { return; }
        if (c >= 0) {
            tuiBufferSet(buf, row, c, cpsInt[i], fg, bg, attr);
        }
        c += 1;
        i += 1;
    }


}

func bufWriteCpsInt(buf: Buffer, row: i32, col: i32,
                   cps: Array<i32>, fg: i32, bg: i32, attr: i32) -> void {
    if (row < 0)           { return; }
    if (row >= buf.height) { return; }
    i: i32 = 0;
    c: i32 = col;
    while (i < length(cps)) {
        if (c >= buf.width) { return; }
        if (c >= 0) {
            tuiBufferSet(buf, row, c, cps[i], fg, bg, attr);
        }
        c += 1;
        i += 1;
    }
}

func bufRepeatCp(buf: Buffer, row: i32, col: i32, n: i32,
                   cp: i32, fg: i32, bg: i32, attr: i32) -> void {
    c: i32 = col;
    i: i32 = 0;
    while (i < n) {
        tuiBufferSet(buf, row, c, cp, fg, bg, attr);
        c += 1;
        i += 1;
    }
}

func bufWriteNum(buf: Buffer, row: i32, col: i32,
                   val: i32, fg: i32, bg: i32, attr: i32) -> i32 {
    start: i32   = col;
    n: i32       = val;
    neg: i32     = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    tmp: i32     = n;
    ndigits: i32 = 1;
    while (tmp >= 10) { tmp = tmp / 10; ndigits += 1; }
    digits: Array<i32> = [];
    i: i32 = 0;
    while (i < ndigits) { digits.push(0); i += 1; }
    tmp  = n;
    pos: i32 = ndigits - 1;
    while (pos >= 0) {
        d: i32 = tmp - (tmp / 10) * 10;
        digits[pos] = 48 + d;
        tmp  = tmp / 10;
        pos -= 1;
    }
    c: i32 = col;
    if (neg == 1) {
        tuiBufferSet(buf, row, c, 45, fg, bg, attr);
        c += 1;
    }
    i = 0;
    while (i < ndigits) {
        tuiBufferSet(buf, row, c, digits[i], fg, bg, attr);
        c += 1;
        i += 1;
    }
    return c - start;
}

func bufWriteNumRight(buf: Buffer, row: i32, col: i32, field_w: i32,
                         val: i32, fg: i32, bg: i32, attr: i32) -> void {
    n: i32       = val;
    neg: i32     = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    tmp: i32     = n;
    ndigits: i32 = 1;
    while (tmp >= 10) { tmp = tmp / 10; ndigits += 1; }
    total: i32 = ndigits + neg;
    pad: i32   = field_w - total;
    if (pad < 0) { pad = 0; }
    c: i32 = col;
    i: i32 = 0;
    while (i < pad) {
        tuiBufferSet(buf, row, c, 32, fg, bg, attr);
        c += 1;
        i += 1;
    }
    bufWriteNum(buf, row, c, val, fg, bg, attr);
}

func bufWritePct(buf: Buffer, row: i32, col: i32,
                   pct: i32, fg: i32, bg: i32, attr: i32) -> void {
    w: i32 = bufWriteNum(buf, row, col, pct, fg, bg, attr);
    tuiBufferSet(buf, row, col + w, 37, fg, bg, attr);
}

func cps8(a: i32, b: i32, c: i32, d: i32,
          e: i32, f: i32, g: i32, h: i32) -> Array<i32> {
    arr: Array<i32> = [];
    if (a != 0) { arr.push(a); } else { return arr; }
    if (b != 0) { arr.push(b); } else { return arr; }
    if (c != 0) { arr.push(c); } else { return arr; }
    if (d != 0) { arr.push(d); } else { return arr; }
    if (e != 0) { arr.push(e); } else { return arr; }
    if (f != 0) { arr.push(f); } else { return arr; }
    if (g != 0) { arr.push(g); } else { return arr; }
    if (h != 0) { arr.push(h); }
    return arr;
}

func cpsConcat(cps1: Array<i32>, cps2: Array<i32>) -> Array<i32> {
    i: i32 = 0;
    while (i < length(cps2)) {
        cps1.push(cps2[i]);
        i += 1;
    }
    return cps1;
}

func panelDraw(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
                title: Array<i32>, fg: i32, bg: i32) -> void {

    tuiBufferFill(buf, row, col, w, h, 32, fg, bg, ATTR_NONE());

    tuiBufferSet(buf, row, col, BOX_TL(), fg, bg, ATTR_NONE());
    title_len: i32 = length(title);
    c: i32 = col + 1;

    if (title_len > 0) {
        tuiBufferSet(buf, row, c, BOX_H(), fg, bg, ATTR_NONE());
        c += 1;
        tuiBufferSet(buf, row, c, 32, fg, bg, ATTR_NONE());
        c += 1;
        ti: i32 = 0;
        while (ti < title_len) {
            if (c >= col + w - 1) { ti = title_len; }
            else {
                tuiBufferSet(buf, row, c, title[ti], fg, bg, ATTR_BOLD());
                c += 1;
                ti += 1;
            }
        }
        if (c < col + w - 1) {
            tuiBufferSet(buf, row, c, 32, fg, bg, ATTR_NONE());
            c += 1;
        }
    }
    while (c < col + w - 1) {
        tuiBufferSet(buf, row, c, BOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row, col + w - 1, BOX_TR(), fg, bg, ATTR_NONE());

    tuiBufferSet(buf, row + h - 1, col, BOX_BL(), fg, bg, ATTR_NONE());
    c = col + 1;
    while (c < col + w - 1) {
        tuiBufferSet(buf, row + h - 1, c, BOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row + h - 1, col + w - 1, BOX_BR(), fg, bg, ATTR_NONE());

    r: i32 = row + 1;
    while (r < row + h - 1) {
        tuiBufferSet(buf, r, col,         BOX_V(), fg, bg, ATTR_NONE());
        tuiBufferSet(buf, r, col + w - 1, BOX_V(), fg, bg, ATTR_NONE());
        r += 1;
    }
}

func boxDraw(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
              fg: i32, bg: i32) -> void {
    empty: Array<i32> = [];
    panelDraw(buf, row, col, w, h, empty, fg, bg);
}

func dBoxDraw(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
               fg: i32, bg: i32) -> void {
    tuiBufferFill(buf, row, col, w, h, 32, fg, bg, ATTR_NONE());
    tuiBufferSet(buf, row, col, DBOX_TL(), fg, bg, ATTR_NONE());
    c: i32 = col + 1;
    while (c < col + w - 1) {
        tuiBufferSet(buf, row, c, DBOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row, col + w - 1, DBOX_TR(), fg, bg, ATTR_NONE());
    tuiBufferSet(buf, row + h - 1, col, DBOX_BL(), fg, bg, ATTR_NONE());
    c = col + 1;
    while (c < col + w - 1) {
        tuiBufferSet(buf, row + h - 1, c, DBOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row + h - 1, col + w - 1, DBOX_BR(), fg, bg, ATTR_NONE());
    r: i32 = row + 1;
    while (r < row + h - 1) {
        tuiBufferSet(buf, r, col,         DBOX_V(), fg, bg, ATTR_NONE());
        tuiBufferSet(buf, r, col + w - 1, DBOX_V(), fg, bg, ATTR_NONE());
        r += 1;
    }
}

func rBoxDraw(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
               fg: i32, bg: i32) -> void {
    tuiBufferFill(buf, row, col, w, h, 32, fg, bg, ATTR_NONE());
    tuiBufferSet(buf, row, col, RBOX_TL(), fg, bg, ATTR_NONE());
    c: i32 = col + 1;
    while (c < col + w - 1) {
        tuiBufferSet(buf, row, c, BOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row, col + w - 1, RBOX_TR(), fg, bg, ATTR_NONE());
    tuiBufferSet(buf, row + h - 1, col, RBOX_BL(), fg, bg, ATTR_NONE());
    c = col + 1;
    while (c < col + w - 1) {
        tuiBufferSet(buf, row + h - 1, c, BOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row + h - 1, col + w - 1, RBOX_BR(), fg, bg, ATTR_NONE());
    r: i32 = row + 1;
    while (r < row + h - 1) {
        tuiBufferSet(buf, r, col,         BOX_V(), fg, bg, ATTR_NONE());
        tuiBufferSet(buf, r, col + w - 1, BOX_V(), fg, bg, ATTR_NONE());
        r += 1;
    }
}

func bufHrule(buf: Buffer, row: i32, col: i32, w: i32,
               fg: i32, bg: i32) -> void {
    tuiBufferSet(buf, row, col, BOX_LM(), fg, bg, ATTR_NONE());
    c: i32 = col + 1;
    while (c < col + w - 1) {
        tuiBufferSet(buf, row, c, BOX_H(), fg, bg, ATTR_NONE());
        c += 1;
    }
    tuiBufferSet(buf, row, col + w - 1, BOX_RM(), fg, bg, ATTR_NONE());
}

func bufVrule(buf: Buffer, row: i32, col: i32, h: i32,
               fg: i32, bg: i32) -> void {
    r: i32 = row;
    while (r < row + h) {
        tuiBufferSet(buf, r, col, BOX_V(), fg, bg, ATTR_NONE());
        r += 1;
    }
}

func gaugeDraw(buf: Buffer, row: i32, col: i32, w: i32,
                pct: i32, filled_fg: i32, filled_bg: i32,
                empty_fg: i32, empty_bg: i32, show_pct: i32) -> void {
    pct_w: i32  = 0;
    if (show_pct == 1) { pct_w = 5; }
    bar_w: i32  = w - pct_w;
    if (bar_w < 1) { bar_w = 1; }
    p: i32 = pct;
    if (p < 0) { p = 0; }
    if (p > 100) { p = 100; }
    filled: i32 = (bar_w * p) / 100;
    c: i32 = col;
    i: i32 = 0;
    while (i < filled) {
        tuiBufferSet(buf, row, c, BLOCK_FULL(), filled_fg, filled_bg, ATTR_NONE());
        c += 1;
        i += 1;
    }
    i = 0;
    while (i < bar_w - filled) {
        tuiBufferSet(buf, row, c, BLOCK_LQTR(), empty_fg, empty_bg, ATTR_NONE());
        c += 1;
        i += 1;
    }
    if (show_pct == 1) {
        tuiBufferSet(buf, row, c, 32, COLOR_WHITE(), COLOR_BLACK(), ATTR_NONE());
        c += 1;
        bufWritePct(buf, row, c, p, COLOR_BRIGHT_WHITE(), COLOR_BLACK(), ATTR_BOLD());
    }
}

func gaugeThin(buf: Buffer, row: i32, col: i32, w: i32,
                pct: i32, filled_bg: i32, empty_bg: i32) -> void {
    p: i32 = pct;
    if (p < 0) { p = 0; }
    if (p > 100) { p = 100; }
    filled: i32 = (w * p) / 100;
    c: i32 = col;
    i: i32 = 0;
    while (i < filled) {
        tuiBufferSet(buf, row, c, 32, filled_bg, filled_bg, ATTR_NONE());
        c += 1;
        i += 1;
    }
    i = 0;
    while (i < w - filled) {
        tuiBufferSet(buf, row, c, 32, empty_bg, empty_bg, ATTR_NONE());
        c += 1;
        i += 1;
    }
}

func gaugeLabeled(buf: Buffer, row: i32, col: i32, w: i32,
                   label: Array<i32>, label_fg: i32,
                   pct: i32, bar_fg: i32, bar_bg: i32,
                   show_pct: i32) -> void {
    llen: i32 = length(label);
    bufWriteCpsInt(buf, row, col, label, label_fg, COLOR_BLACK(), ATTR_NONE());
    bar_col: i32 = col + llen + 1;
    bar_w: i32   = w - llen - 1;
    if (bar_w < 1) { bar_w = 1; }
    gaugeDraw(buf, row, bar_col, bar_w, pct,
               bar_fg, bar_bg, COLOR_BRIGHT_BLACK(), COLOR_BLACK(), show_pct);
}

func sparkChar(level: i32) -> i32 {
    if (level <= 0) { return 32; }
    if (level == 1) { return BLOCK_V1(); }
    if (level == 2) { return BLOCK_V2(); }
    if (level == 3) { return BLOCK_V3(); }
    if (level == 4) { return BLOCK_V4(); }
    if (level == 5) { return BLOCK_V5(); }
    if (level == 6) { return BLOCK_V6(); }
    if (level == 7) { return BLOCK_V7(); }
    return BLOCK_V8();
}

func sparklineDraw(buf: Buffer, row: i32, col: i32, w: i32,
                    values: Array<i32>, min_v: i32, max_v: i32,
                    fg: i32, bg: i32) -> void {
    nv: i32    = length(values);
    range: i32 = max_v - min_v;
    if (range <= 0) { range = 1; }
    start: i32  = nv - w;
    if (start < 0) { start = 0; }
    offset: i32 = w - (nv - start);
    c: i32 = col;
    i: i32 = 0;
    while (i < offset) {
        tuiBufferSet(buf, row, c, 32, fg, bg, ATTR_NONE());
        c += 1;
        i += 1;
    }
    i = start;
    while (i < nv) {
        level: i32 = ((values[i] - min_v) * 8) / range;
        if (level < 0) { level = 0; }
        if (level > 8) { level = 8; }
        tuiBufferSet(buf, row, c, sparkChar(level), fg, bg, ATTR_NONE());
        c += 1;
        i += 1;
    }
}

func sparklineMulti(buf: Buffer, top_row: i32, col: i32, w: i32, h: i32,
                     values: Array<i32>, min_v: i32, max_v: i32,
                     fg: i32, bg: i32) -> void {
    nv: i32          = length(values);
    range: i32       = max_v - min_v;
    if (range <= 0) { range = 1; }
    total_levels: i32 = h * 8;
    start: i32        = nv - w;
    if (start < 0) { start = 0; }
    offset: i32 = w - (nv - start);
    c: i32 = col;
    i: i32 = 0;

    while (i < offset) {
        r: i32 = top_row;
        while (r < top_row + h) {
            tuiBufferSet(buf, r, c, 32, fg, bg, ATTR_NONE());
            r += 1;
        }
        c += 1;
        i += 1;
    }
    i = start;
    while (i < nv) {
        filled: i32 = ((values[i] - min_v) * total_levels) / range;
        if (filled < 0)            { filled = 0; }
        if (filled > total_levels) { filled = total_levels; }
        r: i32        = top_row + h - 1;
        left: i32     = filled;
        while (r >= top_row) {
            if (left >= 8) {
                tuiBufferSet(buf, r, c, BLOCK_V8(), fg, bg, ATTR_NONE());
                left -= 8;
            } else if (left > 0) {
                tuiBufferSet(buf, r, c, sparkChar(left), fg, bg, ATTR_NONE());
                left = 0;
            } else {
                tuiBufferSet(buf, r, c, 32, fg, bg, ATTR_NONE());
            }
            r -= 1;
        }
        c += 1;
        i += 1;
    }
}

func sparklineMultiSeries(buf: Buffer, top_row: i32, col: i32,
                            w: i32, h: i32,
                            series_values: Array<Array<i32>>,
                            min_v: i32, max_v: i32,
                            series_colors: Array<i32>,
                            bg: i32) -> void {
    ns: i32 = length(series_values);

    tuiBufferFill(buf, top_row, col, w, h, 32, COLOR_WHITE(), bg, ATTR_NONE());

    s: i32 = 0;
    while (s < ns) {
        values: Array<i32> = series_values[s];
        fg: i32 = COLOR_WHITE();
        if (s < length(series_colors)) { fg = series_colors[s]; }
        nv: i32    = length(values);
        range: i32 = max_v - min_v;
        if (range <= 0) { range = 1; }
        start: i32 = nv - w;
        if (start < 0) { start = 0; }
        offset: i32 = w - (nv - start);
        c: i32 = col + offset;
        i: i32 = start;
        while (i < nv) {
            level: i32  = ((values[i] - min_v) * (h * 8)) / range;
            if (level < 0) { level = 0; }
            if (level > h * 8) { level = h * 8; }

            dot_row: i32 = top_row + h - 1 - (level / 8);
            if (dot_row < top_row)   { dot_row = top_row; }
            if (dot_row >= top_row + h) { dot_row = top_row + h - 1; }
            tuiBufferSet(buf, dot_row, c, DOT_SMALL(), fg, bg, ATTR_NONE());
            c += 1;
            i += 1;
        }
        s += 1;
    }
}

func barChartDraw(buf: Buffer, top_row: i32, col: i32,
                    w_each: i32, h: i32,
                    bars: Array<i32>, max_v: i32,
                    fg: i32, bg: i32, show_val: i32) -> void {
    nbars: i32 = length(bars);
    mx: i32    = max_v;
    if (mx <= 0) {
        i: i32 = 0;
        while (i < nbars) {
            if (bars[i] > mx) { mx = bars[i]; }
            i += 1;
        }
    }
    if (mx <= 0) { mx = 1; }
    b: i32 = 0;
    c: i32 = col;
    while (b < nbars) {
        v: i32       = bars[b];
        bar_h: i32   = (v * h) / mx;
        if (bar_h > h) { bar_h = h; }
        r: i32 = top_row;
        while (r < top_row + h - bar_h) {
            ci: i32 = 0;
            while (ci < w_each) {
                tuiBufferSet(buf, r, c + ci, 32, fg, bg, ATTR_NONE());
                ci += 1;
            }
            r += 1;
        }
        while (r < top_row + h) {
            ci: i32 = 0;
            while (ci < w_each) {
                tuiBufferSet(buf, r, c + ci, BLOCK_FULL(), fg, bg, ATTR_NONE());
                ci += 1;
            }
            r += 1;
        }
        if (show_val == 1) {
            bufWriteNum(buf, top_row + h, c, v, fg, bg, ATTR_NONE());
        }
        c += w_each;
        b += 1;
    }
}

func barChartColor(buf: Buffer, top_row: i32, col: i32,
                     w_each: i32, h: i32,
                     bars: Array<i32>, colors: Array<i32>,
                     bg: i32, show_val: i32) -> void {
    nbars: i32 = length(bars);
    mx: i32    = 1;
    i: i32     = 0;
    while (i < nbars) {
        if (bars[i] > mx) { mx = bars[i]; }
        i += 1;
    }
    b: i32 = 0;
    c: i32 = col;
    while (b < nbars) {
        v: i32     = bars[b];
        bar_h: i32 = (v * h) / mx;
        if (bar_h > h) { bar_h = h; }
        fg: i32    = COLOR_WHITE();
        if (b < length(colors)) { fg = colors[b]; }
        r: i32 = top_row;
        while (r < top_row + h - bar_h) {
            ci: i32 = 0;
            while (ci < w_each) {
                tuiBufferSet(buf, r, c + ci, 32, fg, bg, ATTR_NONE());
                ci += 1;
            }
            r += 1;
        }
        while (r < top_row + h) {
            ci: i32 = 0;
            while (ci < w_each) {
                tuiBufferSet(buf, r, c + ci, BLOCK_FULL(), fg, bg, ATTR_NONE());
                ci += 1;
            }
            r += 1;
        }
        if (show_val == 1) {
            bufWriteNum(buf, top_row + h, c, v, fg, bg, ATTR_NONE());
        }
        c += w_each;
        b += 1;
    }
}

func graphPlotDot(buf: Buffer, top_row: i32, left_col: i32,
                    w: i32, h: i32,
                    data_x: i32, data_y: i32,
                    min_x: i32, max_x: i32,
                    min_y: i32, max_y: i32,
                    ch: i32, fg: i32, bg: i32) -> void {
    rx: i32 = max_x - min_x;
    ry: i32 = max_y - min_y;
    if (rx <= 0) { rx = 1; }
    if (ry <= 0) { ry = 1; }
    sc: i32 = left_col + ((data_x - min_x) * (w - 1)) / rx;
    sr: i32 = top_row  + h - 1 - ((data_y - min_y) * (h - 1)) / ry;
    tuiBufferSet(buf, sr, sc, ch, fg, bg, ATTR_NONE());
}

func lineGraphDraw(buf: Buffer, top_row: i32, left_col: i32,
                     w: i32, h: i32,
                     xs: Array<i32>, ys: Array<i32>,
                     min_x: i32, max_x: i32,
                     min_y: i32, max_y: i32,
                     fg: i32, bg: i32) -> void {
    tuiBufferFill(buf, top_row, left_col, w, h, 32, fg, bg, ATTR_NONE());
    n: i32 = length(xs);
    if (length(ys) < n) { n = length(ys); }
    i: i32 = 0;
    while (i < n) {
        graphPlotDot(buf, top_row, left_col, w, h,
                       xs[i], ys[i],
                       min_x, max_x, min_y, max_y,
                       DOT_SMALL(), fg, bg);
        i += 1;
    }
}

func graphYaxis(buf: Buffer, top_row: i32, left_col: i32, h: i32,
                  min_y: i32, max_y: i32, nticks: i32,
                  fg: i32, bg: i32) -> void {
    if (nticks < 2) { nticks = 2; }
    i: i32 = 0;
    while (i <= nticks) {
        v: i32   = min_y + ((max_y - min_y) * i) / nticks;
        r: i32   = top_row + h - 1 - (i * (h - 1)) / nticks;
        bufWriteNumRight(buf, r, left_col, 6, v, fg, bg, ATTR_NONE());
        i += 1;
    }
}

func graphXaxis(buf: Buffer, axis_row: i32, left_col: i32, w: i32,
                  min_x: i32, max_x: i32, nticks: i32,
                  fg: i32, bg: i32) -> void {
    if (nticks < 2) { nticks = 2; }
    i: i32 = 0;
    while (i <= nticks) {
        v: i32 = min_x + ((max_x - min_x) * i) / nticks;
        c: i32 = left_col + (i * (w - 1)) / nticks;
        bufWriteNum(buf, axis_row, c, v, fg, bg, ATTR_NONE());
        i += 1;
    }
}

func tableHeaderSep(buf: Buffer, row: i32, col: i32,
                      col_widths: Array<i32>, ncols: i32,
                      fg: i32, bg: i32) -> void {
    c: i32 = col;
    i: i32 = 0;
    while (i < ncols) {
        w: i32 = col_widths[i];
        j: i32 = 0;
        while (j < w) {
            tuiBufferSet(buf, row, c, BOX_H(), fg, bg, ATTR_NONE());
            c += 1;
            j += 1;
        }
        if (i < ncols - 1) {
            tuiBufferSet(buf, row, c, BOX_TM(), fg, bg, ATTR_NONE());
            c += 1;
        }
        i += 1;
    }
}

func tableRowSep(buf: Buffer, row: i32, col: i32,
                   col_widths: Array<i32>, ncols: i32,
                   fg: i32, bg: i32) -> void {
    c: i32 = col;
    i: i32 = 0;
    while (i < ncols) {
        w: i32 = col_widths[i];
        j: i32 = 0;
        while (j < w) {
            tuiBufferSet(buf, row, c, BOX_H(), fg, bg, ATTR_NONE());
            c += 1;
            j += 1;
        }
        if (i < ncols - 1) {
            tuiBufferSet(buf, row, c, BOX_CROSS(), fg, bg, ATTR_NONE());
            c += 1;
        }
        i += 1;
    }
}

func tableCellNum(buf: Buffer, row: i32, col: i32, cell_w: i32,
                    val: i32, fg: i32, bg: i32, attr: i32) -> void {
    bufWriteNumRight(buf, row, col, cell_w, val, fg, bg, attr);
}

func tableSortAsc() -> i32  { return ARROW_UP(); }
func tableSortDesc() -> i32 { return ARROW_DOWN(); }

func tableColHeader(buf: Buffer, row: i32, col: i32, cell_w: i32,
                      label: Array<i32>, sort_dir: i32,
                      fg: i32, bg: i32) -> void {
    bufWriteCpsInt(buf, row, col, label, fg, bg, ATTR_BOLD());
    if (sort_dir != 0) {
        tuiBufferSet(buf, row, col + length(label) + 1,
                   sort_dir, COLOR_BRIGHT_YELLOW(), bg, ATTR_NONE());
    }

    pad_start: i32 = col + length(label) + cast<i32>(sort_dir != 0);
    c: i32 = pad_start;
    while (c < col + cell_w) {
        tuiBufferSet(buf, row, c, 32, fg, bg, ATTR_NONE());
        c += 1;
    }
}

block LogView {
    lines:      Array<Array<i32>>
    line_fgs:   Array<i32>
    line_count: i32
    scroll_top: i32
    height:     i32
    width:      i32
    fg:         i32
    bg:         i32
}

func logviewNew(height: i32, width: i32, fg: i32, bg: i32) -> LogView {
    lv: LogView;
    lv.lines      = [];
    lv.line_fgs   = [];
    lv.line_count = 0;
    lv.scroll_top = 0;
    lv.height     = height;
    lv.width      = width;
    lv.fg         = fg;
    lv.bg         = bg;
    return lv;
}

func logviewPushColored(lv: LogView, line: Array<i32>, fg: i32) -> void {
    lv.lines.push(line);
    lv.line_fgs.push(fg);
    lv.line_count += 1;
    if (lv.line_count > lv.height) {
        lv.scroll_top = lv.line_count - lv.height;
    }
}

func logviewPush(lv: LogView, line: Array<i32>) -> void {
    logviewPushColored(lv, line, lv.fg);
}

func logviewScrollUp(lv: LogView, n: i32) -> void {
    lv.scroll_top -= n;
    if (lv.scroll_top < 0) { lv.scroll_top = 0; }
}

func logviewScrollDown(lv: LogView, n: i32) -> void {
    lv.scroll_top += n;
    max_top: i32 = lv.line_count - lv.height;
    if (max_top < 0) { max_top = 0; }
    if (lv.scroll_top > max_top) { lv.scroll_top = max_top; }
}

func logviewRender(buf: Buffer, lv: LogView,
                    top_row: i32, left_col: i32) -> void {
    visible: i32 = lv.height;
    row: i32     = top_row;
    rendered: i32 = 0;
    i: i32       = lv.scroll_top;
    while (i < lv.line_count) {
        if (rendered >= visible) { i = lv.line_count; }
        else {
            line: Array<i32> = lv.lines[i];
            fg: i32 = lv.fg;
            if (i < length(lv.line_fgs)) { fg = lv.line_fgs[i]; }

            c: i32 = left_col;
            j: i32 = 0;
            while (j < length(line)) {
                if (c >= left_col + lv.width) { j = length(line); }
                else {
                    tuiBufferSet(buf, row, c, line[j], fg, lv.bg, ATTR_NONE());
                    c += 1;
                    j += 1;
                }
            }

            while (c < left_col + lv.width) {
                tuiBufferSet(buf, row, c, 32, fg, lv.bg, ATTR_NONE());
                c += 1;
            }
            row     += 1;
            rendered += 1;
            i        += 1;
        }
    }

    while (rendered < visible) {
        c: i32 = left_col;
        while (c < left_col + lv.width) {
            tuiBufferSet(buf, row, c, 32, lv.fg, lv.bg, ATTR_NONE());
            c += 1;
        }
        row     += 1;
        rendered += 1;
    }
}

func statusBar(buf: Buffer, row: i32, w: i32,
                left_cps:  Array<i32>, left_fg:  i32, left_bg: i32,
                right_cps: Array<i32>, right_fg: i32, right_bg: i32) -> void {
    tuiBufferFill(buf, row, 0, w, 1, 32, left_fg, left_bg, ATTR_NONE());
    bufWriteCpsInt(buf, row, 0, left_cps, left_fg, left_bg, ATTR_BOLD());
    rlen: i32    = length(right_cps);
    start_c: i32 = w - rlen;
    if (start_c < 0) { start_c = 0; }
    bufWriteCpsInt(buf, row, start_c, right_cps, right_fg, right_bg, ATTR_NONE());
}

func keyhintBar(buf: Buffer, row: i32, col: i32,
                 hint_cps: Array<i32>,
                 key_fg: i32, key_bg: i32,
                 label_fg: i32, label_bg: i32) -> void {
    i: i32     = 0;
    c: i32     = col;
    in_key: i32 = 1;
    while (i < length(hint_cps)) {
        cp: i32 = hint_cps[i];
        if (cp == 0) {
            in_key = 1 - in_key;
            if (in_key == 1) {
                tuiBufferSet(buf, row, c, 32, label_fg, label_bg, ATTR_NONE());
                c += 1;
            }
        } else {
            if (in_key == 1) {
                tuiBufferSet(buf, row, c, cp, key_fg, key_bg, ATTR_BOLD());
            } else {
                tuiBufferSet(buf, row, c, cp, label_fg, label_bg, ATTR_NONE());
            }
            c += 1;
        }
        i += 1;
    }
}

func legendDraw(buf: Buffer, top_row: i32, left_col: i32,
                 colors: Array<i32>,
                 labels: Array<Array<i32>>,
                 text_fg: i32, bg: i32) -> void {
    n: i32   = length(colors);
    row: i32 = top_row;
    i: i32   = 0;
    while (i < n) {
        tuiBufferSet(buf, row, left_col,     BLOCK_FULL(), colors[i], bg, ATTR_NONE());
        tuiBufferSet(buf, row, left_col + 1, BLOCK_FULL(), colors[i], bg, ATTR_NONE());
        tuiBufferSet(buf, row, left_col + 2, 32,           text_fg,   bg, ATTR_NONE());
        if (i < length(labels)) {
            bufWriteCpsInt(buf, row, left_col + 3, labels[i], text_fg, bg, ATTR_NONE());
        }
        row += 1;
        i   += 1;
    }
}

func legendHorizontal(buf: Buffer, row: i32, col: i32,
                       colors: Array<i32>,
                       labels: Array<Array<i32>>,
                       text_fg: i32, bg: i32) -> void {
    n: i32 = length(colors);
    c: i32 = col;
    i: i32 = 0;
    while (i < n) {
        tuiBufferSet(buf, row, c, BLOCK_FULL(), colors[i], bg, ATTR_NONE());
        c += 1;
        tuiBufferSet(buf, row, c, 32, text_fg, bg, ATTR_NONE());
        c += 1;
        if (i < length(labels)) {
            bufWriteCpsInt(buf, row, c, labels[i], text_fg, bg, ATTR_NONE());
            c += length(labels[i]);
        }
        tuiBufferSet(buf, row, c, 32, text_fg, bg, ATTR_NONE());
        c += 2;
        i += 1;
    }
}

func panelGauge(buf: Buffer, row: i32, col: i32, w: i32,
                 title: Array<i32>, pct: i32,
                 bar_fg: i32, bar_bg: i32, panel_fg: i32) -> void {
    panelDraw(buf, row, col, w, 3, title, panel_fg, COLOR_BLACK());
    gaugeThin(buf, row + 1, col + 1, w - 6, pct, bar_bg,
               COLOR_BRIGHT_BLACK());
    bufWritePct(buf, row + 1, col + w - 5, pct,
                  COLOR_BRIGHT_WHITE(), COLOR_BLACK(), ATTR_BOLD());
}

func panelSparkline(buf: Buffer, row: i32, col: i32, w: i32,
                     title: Array<i32>, values: Array<i32>,
                     min_v: i32, max_v: i32,
                     spark_fg: i32, panel_fg: i32) -> void {
    panelDraw(buf, row, col, w, 3, title, panel_fg, COLOR_BLACK());
    sparklineDraw(buf, row + 1, col + 1, w - 2,
                   values, min_v, max_v, spark_fg, COLOR_BLACK());
}

func panelGraph(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
                 title: Array<i32>, values: Array<i32>,
                 min_v: i32, max_v: i32,
                 spark_fg: i32, panel_fg: i32) -> void {
    panelDraw(buf, row, col, w, h, title, panel_fg, COLOR_BLACK());
    sparklineMulti(buf, row + 1, col + 1, w - 2, h - 2,
                    values, min_v, max_v, spark_fg, COLOR_BLACK());

    bufWriteNum(buf, row + 1,     col + w - 6, max_v,
                  COLOR_MUTED(), COLOR_BLACK(), ATTR_NONE());
    bufWriteNum(buf, row + h - 2, col + w - 6, min_v,
                  COLOR_MUTED(), COLOR_BLACK(), ATTR_NONE());
}

func panelGraphMulti(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
                       title: Array<i32>,
                       series_values: Array<Array<i32>>,
                       min_v: i32, max_v: i32,
                       series_colors: Array<i32>, panel_fg: i32) -> void {
    panelDraw(buf, row, col, w, h, title, panel_fg, COLOR_BLACK());
    sparklineMultiSeries(buf, row + 1, col + 1, w - 2, h - 2,
                           series_values, min_v, max_v,
                           series_colors, COLOR_BLACK());
    bufWriteNum(buf, row + 1,     col + w - 6, max_v,
                  COLOR_MUTED(), COLOR_BLACK(), ATTR_NONE());
    bufWriteNum(buf, row + h - 2, col + w - 6, min_v,
                  COLOR_MUTED(), COLOR_BLACK(), ATTR_NONE());
}

func infoList(buf: Buffer, top_row: i32, left_col: i32,
               keys: Array<Array<i32>>, vals: Array<i32>,
               label_fg: i32, val_fg: i32, bg: i32) -> void {
    n: i32   = length(keys);
    if (length(vals) < n) { n = length(vals); }
    row: i32 = top_row;
    i: i32   = 0;
    while (i < n) {
        bufWriteCpsInt(buf, row, left_col, keys[i], label_fg, bg, ATTR_NONE());
        bufWriteNum(buf, row, left_col + length(keys[i]) + 1, vals[i],
                      val_fg, bg, ATTR_BOLD());
        row += 1;
        i   += 1;
    }
}

func infoListGauged(buf: Buffer, top_row: i32, left_col: i32,
                      keys: Array<Array<i32>>, vals: Array<i32>,
                      bar_w: i32, bar_fg: i32,
                      label_fg: i32, val_fg: i32, bg: i32) -> void {
    n: i32   = length(keys);
    if (length(vals) < n) { n = length(vals); }
    row: i32 = top_row;
    i: i32   = 0;
    while (i < n) {
        klen: i32 = length(keys[i]);
        bufWriteCpsInt(buf, row, left_col, keys[i], label_fg, bg, ATTR_NONE());
        gaugeThin(buf, row, left_col + klen + 1, bar_w, vals[i],
                   bar_fg, COLOR_BRIGHT_BLACK());
        bufWritePct(buf, row, left_col + klen + 1 + bar_w + 1, vals[i],
                      val_fg, bg, ATTR_NONE());
        row += 1;
        i   += 1;
    }
}

func tuiClamp(v: i32, lo: i32, hi: i32) -> i32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

func tuiMap(v: i32, in_min: i32, in_max: i32,
             out_min: i32, out_max: i32) -> i32 {
    r_in: i32  = in_max - in_min;
    r_out: i32 = out_max - out_min;
    if (r_in == 0) { return out_min; }
    return out_min + ((v - in_min) * r_out) / r_in;
}

func tuiMax(a: i32, b: i32) -> i32 {
    if (a > b) { return a; }
    return b;
}

func tuiMin(a: i32, b: i32) -> i32 {
    if (a < b) { return a; }
    return b;
}

func tuiAbs(v: i32) -> i32 {
    if (v < 0) { return 0 - v; }
    return v;
}

func tuiIsqrt(n: i32) -> i32 {
    if (n <= 0) { return 0; }
    x: i32 = n;
    while (x * x > n) { x = (x + n / x) / 2; }
    return x;
}

func arrMax(arr: Array<i32>) -> i32 {
    n: i32 = length(arr);
    if (n == 0) { return 0; }
    m: i32 = arr[0];
    i: i32 = 1;
    while (i < n) {
        if (arr[i] > m) { m = arr[i]; }
        i += 1;
    }
    return m;
}

func arrMin(arr: Array<i32>) -> i32 {
    n: i32 = length(arr);
    if (n == 0) { return 0; }
    m: i32 = arr[0];
    i: i32 = 1;
    while (i < n) {
        if (arr[i] < m) { m = arr[i]; }
        i += 1;
    }
    return m;
}

func arrSum(arr: Array<i32>) -> i32 {
    total: i32 = 0;
    i: i32     = 0;
    while (i < length(arr)) {
        total += arr[i];
        i     += 1;
    }
    return total;
}

func ringPush(ring: Array<i32>, val: i32, max_len: i32) -> void {
    // Previously this rebuilt 'ring' via a manual shift-and-copy into a
    // 'tmp' array, then a trailing loop meant to drop the now-stale tail
    // slot instead re-grew the array by one element (a bug: it should
    // have shrunk 'ring' to length(tmp), but Array<T> has no truncate
    // operation, so the old code approximated it with pushes that
    // overshot). That left 'ring' one element *longer* than before the
    // trim, so the outer while(length(ring) > max_len) condition could
    // never clear once it first triggered -- an infinite loop on the
    // very first push past max_len. removeAt(0) does the same "drop the
    // oldest element" job correctly and without the manual copy.
    ring.push(val);
    while (length(ring) > max_len) {
        ring.removeAt(0);
    }
}

block BrailleCanvas {
    dots:    Array<i32>
    colors:  Array<i32>
    w_cells: i32
    h_cells: i32
    w_px:    i32
    h_px:    i32
}

func bcNew(w_cells: i32, h_cells: i32) -> BrailleCanvas {
    bc: BrailleCanvas;
    bc.w_cells = w_cells;
    bc.h_cells = h_cells;
    bc.w_px    = w_cells * 2;
    bc.h_px    = h_cells * 4;
    total: i32 = w_cells * h_cells;
    bc.dots   = [];
    bc.colors = [];
    i: i32 = 0;
    while (i < total) {
        bc.dots.push(0);
        bc.colors.push(COLOR_WHITE());
        i += 1;
    }
    return bc;
}

func bcClear(bc: BrailleCanvas) -> void {
    total: i32 = bc.w_cells * bc.h_cells;
    i: i32 = 0;
    while (i < total) {
        bc.dots[i]   = 0;
        bc.colors[i] = COLOR_WHITE();
        i += 1;
    }
}

func bcBrailleBit(px_col: i32, px_row: i32) -> i32 {
    if (px_col == 0) {
        if (px_row == 0) { return 0; }
        if (px_row == 1) { return 1; }
        if (px_row == 2) { return 2; }
        return 6;
    }
    if (px_row == 0) { return 3; }
    if (px_row == 1) { return 4; }
    if (px_row == 2) { return 5; }
    return 7;
}

func bcBrailleCp(bits: i32) -> i32 {
    return 0x2800 + bits;
}

func bcBitsToCp(bits: i32) -> i32 {

    return 0x2800 + bits;
}

func bcDot(bc: BrailleCanvas, x: i32, y: i32, color: i32) -> void {
    if (x < 0)         { return; }
    if (y < 0)         { return; }
    if (x >= bc.w_px)  { return; }
    if (y >= bc.h_px)  { return; }
    cell_x: i32 = x / 2;
    cell_y: i32 = y / 4;
    px_col: i32 = x - (cell_x * 2);
    px_row: i32 = y - (cell_y * 4);
    idx: i32    = cell_y * bc.w_cells + cell_x;
    bit: i32    = bcBrailleBit(px_col, px_row);
    bc.dots[idx]   = bc.dots[idx] | (1 << bit);
    bc.colors[idx] = color;
    if (bc.colors[idx] == COLOR_WHITE()) {
        bc.colors[idx] = color;
    }
    if (color != COLOR_WHITE()) {
        bc.colors[idx] = color;
    }}

func bcLine(bc: BrailleCanvas,
                         x0: i32, y0: i32, x1: i32, y1: i32,
                         color: i32) -> void {
    dx: i32  = x1 - x0;
    dy: i32  = y1 - y0;
    adx: i32 = dx; if (adx < 0) { adx = 0 - adx; }
    ady: i32 = dy; if (ady < 0) { ady = 0 - ady; }
    sx: i32  = 1;  if (dx < 0)  { sx = 0 - 1; }
    sy: i32  = 1;  if (dy < 0)  { sy = 0 - 1; }
    err: i32 = adx - ady;
    x: i32   = x0;
    y: i32   = y0;
    while (true) {
        bcDot(bc, x, y, color);
        if (x == x1) { if (y == y1) { return; } }
        e2: i32 = err * 2;
        if (e2 > (0 - ady)) { err = err - ady; x = x + sx; }
        if (e2 < adx)        { err = err + adx; y = y + sy; }
    }
}

func bcPlot(bc: BrailleCanvas,
                         data: Array<f64>, len: i32,
                         vmin: f64, vmax: f64,
                         ml: i32, mr: i32, mt: i32, mb: i32,
                         color: i32) -> void {
    if (len <= 0) { return; }
    range: f64   = vmax - vmin;
    if (range == 0.0) { range = 1.0; }
    plot_w: i32  = bc.w_px - ml - mr;
    plot_h: i32  = bc.h_px - mt - mb;
    plot_hf: f64 = plot_h;
    prev_px: i32 = ml;
    prev_py: i32 = bc.h_px - mb;
    j: i32 = 0;
    while (j < len) {
        px: i32   = ml + (j * plot_w / (len - 1));
        norm: f64 = (data[j] - vmin) / range;
        py: i32   = bc.h_px - mb - floor(norm * plot_hf);
        if (j == 0) { bcDot(bc, px, py, color); }
        else        { bcLine(bc, prev_px, prev_py, px, py, color); }
        prev_px = px;
        prev_py = py;
        j += 1;
    }
}

func bcFlush(bc: BrailleCanvas, buf: Buffer,
                          buf_row: i32, buf_col: i32,
                          bg: i32) -> void {
    r: i32 = 0;
    while (r < bc.h_cells) {
        c: i32 = 0;
        while (c < bc.w_cells) {
            idx: i32  = r * bc.w_cells + c;
            bits: i32 = bc.dots[idx];
            if (bits != 0) {
                cp: i32    = bcBitsToCp(bits);
                fg: i32    = bc.colors[idx];
                tuiBufferSet(buf, buf_row + r, buf_col + c, cp, fg, bg, ATTR_NONE());
            }
            c += 1;
        }
        r += 1;
    }
}

func brailleChartDraw(buf: Buffer,
                        top_row: i32, left_col: i32,
                        w: i32, h: i32,
                        series: Array<Array<f64>>,
                        series_colors: Array<i32>,
                        vmin: f64, vmax: f64,
                        y_label_w: i32,
                        bg: i32) -> void {
    ns: i32 = length(series);
    if (ns == 0) { return; }

    if (vmin == vmax) {
        vmin = series[0][0];
        vmax = series[0][0];
        si: i32 = 0;
        while (si < ns) {
            di: i32 = 0;
            dlen: i32 = length(series[si]);
            while (di < dlen) {
                v: f64 = series[si][di];
                if (v < vmin) { vmin = v; }
                if (v > vmax) { vmax = v; }
                di += 1;
            }
            si += 1;
        }
    }

    nticks: i32 = h - 1;
    if (nticks < 1) { nticks = 1; }
    ti: i32 = 0;
    while (ti <= nticks) {

        tick_r: i32 = top_row + h - 1 - (ti * (h - 1)) / nticks;

        // Was `ti / nticks` -- integer division between two i32s,
        // truncating to 0 for every tick except the last (where ti ==
        // nticks) before the result was ever widened to f64, so every
        // label but the topmost one printed vmin's value instead of its
        // own interpolated one. nticks is guarded >= 1 above, so this
        // cast introduces no new divide-by-zero risk.
        frac: f64   = cast<f64>(ti) / cast<f64>(nticks);
        val: f64    = vmin + frac * (vmax - vmin);

        scaled: i32 = floor(val * 100.0 + 0.5);
        int_p: i32  = scaled / 100;
        frac_p: i32 = scaled - int_p * 100;

        lbl: Array<i32> = [];

        tmp: i32 = int_p;
        if (tmp < 0) { tmp = 0 - tmp; }
        ndig: i32 = 1;
        t2: i32 = tmp;
        while (t2 >= 10) { t2 = t2 / 10; ndig += 1; }

        pad: i32 = y_label_w - ndig - 3;
        pi: i32 = 0;
        while (pi < pad) { lbl.push(32); pi += 1; }
        if (val < 0.0) { lbl.push(45); }

        dig_arr: Array<i32> = [];
        t2 = tmp;
        pos: i32 = ndig - 1;
        while (pos >= 0) {
            d: i32 = t2 - (t2 / 10) * 10;
            dig_arr.push(48 + d);
            t2 = t2 / 10;
            pos -= 1;
        }

        fwd: Array<i32> = [];
        ri: i32 = ndig - 1;
        while (ri >= 0) { fwd.push(dig_arr[ri]); ri -= 1; }
        pi = 0;
        while (pi < length(fwd)) { lbl.push(fwd[pi]); pi += 1; }
        lbl.push(46);

        f1: i32 = frac_p / 10;
        f2: i32 = frac_p - f1 * 10;
        lbl.push(48 + f1);
        lbl.push(48 + f2);
        bufWriteCpsInt(buf, tick_r, left_col, lbl,
                      COLOR_WHITE(), bg, ATTR_NONE());
        ti += 1;
    }

    plot_col: i32 = left_col + y_label_w;
    plot_w:   i32 = w - y_label_w;
    if (plot_w < 2) { return; }

    bc: BrailleCanvas = bcNew(plot_w, h);

    ml: i32 = 0;
    mr: i32 = 2;
    mt: i32 = 1;
    mb: i32 = 1;
    si: i32 = 0;
    while (si < ns) {
        color: i32 = COLOR_WHITE();
        if (si < length(series_colors)) { color = series_colors[si]; }
        dlen: i32 = length(series[si]);
        bcPlot(bc, series[si], dlen,
                            vmin, vmax,
                            ml, mr, mt, mb, color);
        si += 1;
    }
    bcLine(bc, ml, mt, ml, bc.h_px - mb - 1, COLOR_WHITE());

    bcLine(bc, ml, bc.h_px - mb - 1, bc.w_px - mr - 1, bc.h_px - mb - 1, COLOR_WHITE());

    bcFlush(bc, buf, top_row, plot_col, bg);
}

func KEY_NONE() -> i32        { return 0; }

func KEY_UP() -> i32          { return 1000; }
func KEY_DOWN() -> i32        { return 1001; }
func KEY_RIGHT() -> i32       { return 1002; }
func KEY_LEFT() -> i32        { return 1003; }

func KEY_HOME() -> i32        { return 1004; }
func KEY_END() -> i32         { return 1005; }
func KEY_INSERT() -> i32      { return 1006; }
func KEY_DELETE() -> i32      { return 1007; }
func KEY_PAGE_UP() -> i32     { return 1008; }
func KEY_PAGE_DOWN() -> i32   { return 1009; }

func KEY_F1() -> i32          { return 1011; }
func KEY_F2() -> i32          { return 1012; }
func KEY_F3() -> i32          { return 1013; }
func KEY_F4() -> i32          { return 1014; }
func KEY_F5() -> i32          { return 1015; }
func KEY_F6() -> i32          { return 1016; }
func KEY_F7() -> i32          { return 1017; }
func KEY_F8() -> i32          { return 1018; }
func KEY_F9() -> i32          { return 1019; }
func KEY_F10() -> i32         { return 1020; }
func KEY_F11() -> i32         { return 1021; }
func KEY_F12() -> i32         { return 1022; }

func KEY_SHIFT_UP() -> i32    { return 1030; }
func KEY_SHIFT_DOWN() -> i32  { return 1031; }
func KEY_SHIFT_RIGHT() -> i32 { return 1032; }
func KEY_SHIFT_LEFT() -> i32  { return 1033; }

func KEY_CTRL_UP() -> i32     { return 1040; }
func KEY_CTRL_DOWN() -> i32   { return 1041; }
func KEY_CTRL_RIGHT() -> i32  { return 1042; }
func KEY_CTRL_LEFT() -> i32   { return 1043; }

func KEY_ALT_UP() -> i32      { return 1050; }
func KEY_ALT_DOWN() -> i32    { return 1051; }
func KEY_ALT_RIGHT() -> i32   { return 1052; }
func KEY_ALT_LEFT() -> i32    { return 1053; }

func KEY_ESCAPE() -> i32      { return 27;  }
func KEY_ENTER() -> i32       { return 13;  }
func KEY_BACKSPACE() -> i32   { return 127; }
func KEY_TAB() -> i32         { return 9;   }
func KEY_SPACE() -> i32       { return 32;  }

func KEY_CTRL_C() -> i32      { return 3;  }
func KEY_CTRL_D() -> i32      { return 4;  }
func KEY_CTRL_Q() -> i32      { return 17; }
func KEY_CTRL_S() -> i32      { return 19; }
func KEY_CTRL_Z() -> i32      { return 26; }
func KEY_CTRL_L() -> i32      { return 12; }

func keyIsPrintable(key: i32) -> i32 {
    if (key >= 32) {
        if (key <= 126) { return 1; }
    }
    return 0;
}

func keyIsDigit(key: i32) -> i32 {
    if (key >= 48) {
        if (key <= 57) { return 1; }
    }
    return 0;
}

func keyIsLower(key: i32) -> i32 {
    if (key >= 97) {
        if (key <= 122) { return 1; }
    }
    return 0;
}

func keyIsUpper(key: i32) -> i32 {
    if (key >= 65) {
        if (key <= 90) { return 1; }
    }
    return 0;
}

func keyIsArrow(key: i32) -> i32 {
    if (key >= 1000) {
        if (key <= 1003) { return 1; }
    }
    if (key >= 1030) {
        if (key <= 1033) { return 1; }
    }
    if (key >= 1040) {
        if (key <= 1043) { return 1; }
    }
    if (key >= 1050) {
        if (key <= 1053) { return 1; }
    }
    return 0;
}

func keyIsFkey(key: i32) -> i32 {
    if (key >= 1011) {
        if (key <= 1022) { return 1; }
    }
    return 0;
}

func tuiSetup() -> void {
    rawModeEnter();
    tuiEnterAltScreen();
    tuiHideCursor();
    tuiClear();
}

func tuiCleanup() -> void {
    tuiReset();
    tuiShowCursor();
    tuiExitAltScreen();
    rawModeLeave();
}
