func COLOR_MUTED() -> i32    { return 8; }

func tuiFg(color: i32) -> void {
    if (color >= 8) {
        ioPrint("\033[", 90 + (color - 8), "m");
    } else {
        ioPrint("\033[", 30 + color, "m");
    }
}

func tuiBg(color: i32) -> void {
    if (color >= 8) {
        ioPrint("\033[", 100 + (color - 8), "m");
    } else {
        ioPrint("\033[", 40 + color, "m");
    }
}

func tuiFg256(n: i32) -> void { ioPrint("\033[38;5;", n, "m"); }
func tuiBg256(n: i32) -> void { ioPrint("\033[48;5;", n, "m"); }

func ATTR_NONE() -> i32      { return 0; }
func ATTR_BOLD() -> i32      { return 1; }
func ATTR_DIM() -> i32       { return 2; }
func ATTR_ITALIC() -> i32    { return 4; }
func ATTR_UNDERLINE() -> i32 { return 8; }
func ATTR_REVERSE() -> i32   { return 16; }

func tuiApplyAttr(attr: i32) -> void {
    if (attr == 0) { return; }
    a: i32 = attr;

    if (a >= 1) {
        r: i32 = a - 1;
        if (r < 1) { ioPrint("\033[1m"); }
    }

    if (a >= 2) {
        r: i32 = a - 2;
        if (r < 2) { ioPrint("\033[2m"); }
    }

    if (a >= 4) {
        r: i32 = a - 4;
        if (r < 4) { ioPrint("\033[3m"); }
    }

    if (a >= 8) {
        r: i32 = a - 8;
        if (r < 8) { ioPrint("\033[4m"); }
    }

    if (a >= 16) {
        r: i32 = a - 16;
        if (r < 16) { ioPrint("\033[7m"); }
    }
}

block Cell {
    ch:   i32;
    fg:   i32;
    bg:   i32;
    attr: i32;
}

block Buffer {
    cells:  Array<Cell>
    width:  i32
    height: i32
}

func tuiCellMake(ch: i32, fg: i32, bg: i32, attr: i32) -> Cell {
    c: Cell;
    c.ch   = ch;
    c.fg   = fg;
    c.bg   = bg;
    c.attr = attr;
    return c;
}

func tuiBufferNew(width: i32, height: i32) -> Buffer {
    buf: Buffer;
    buf.cells  = [];
    buf.width  = width;
    buf.height = height;
    total: i32 = width * height;
    i: i32 = 0;
    while (i < total) {
        buf.cells.push(tuiCellMake(32, COLOR_WHITE(), COLOR_BLACK(), ATTR_NONE()));
        i += 1;
    }
    return buf;
}

func tuiBufferSet(buf: Buffer, row: i32, col: i32,
                ch: i32, fg: i32, bg: i32, attr: i32) -> void {
    if (row < 0)           { return; }
    if (col < 0)           { return; }
    if (row >= buf.height) { return; }
    if (col >= buf.width)  { return; }
    idx: i32 = row * buf.width + col;
    buf.cells[idx] = tuiCellMake(ch, fg, bg, attr);
}

func tuiBufferFill(buf: Buffer, row: i32, col: i32, w: i32, h: i32,
                 ch: i32, fg: i32, bg: i32, attr: i32) -> void {
    r: i32 = row;
    while (r < row + h) {
        c: i32 = col;
        while (c < col + w) {
            tuiBufferSet(buf, r, c, ch, fg, bg, attr);
            c += 1;
        }
        r += 1;
    }
}

func tuiBufferClear(buf: Buffer) -> void {
    tuiBufferFill(buf, 0, 0, buf.width, buf.height,
                32, COLOR_WHITE(), COLOR_BLACK(), ATTR_NONE());
}

func tuiBufferClearRegion(buf: Buffer, row: i32, col: i32,
                         w: i32, h: i32) -> void {
    tuiBufferFill(buf, row, col, w, h, 32,
                COLOR_WHITE(), COLOR_BLACK(), ATTR_NONE());
}

func tuiBufferRender(buf: Buffer) -> void {

    ioPrint("\033[?25l");
    last_fg:   i32 = -1;
    last_bg:   i32 = -1;
    last_attr: i32 = -1;
    row: i32 = 0;
    while (row < buf.height) {
        ioPrint("\033[", row + 1, ";1H");
        col: i32 = 0;
        while (col < buf.width) {
            idx: i32   = row * buf.width + col;
            cell: Cell = buf.cells[idx];
            if (cell.attr != last_attr) {
                if (last_attr != 0) {
                    ioPrint("\033[0m");
                    last_fg   = -1;
                    last_bg   = -1;
                    last_attr = 0;
                }
            }
            if (cell.fg != last_fg) {
                tuiFg(cell.fg);
                last_fg = cell.fg;
            }
            if (cell.bg != last_bg) {
                tuiBg(cell.bg);
                last_bg = cell.bg;
            }
            if (cell.attr != last_attr) {
                tuiApplyAttr(cell.attr);
                last_attr = cell.attr;
            }
            ioPrint(intToChar(cell.ch));
            col += 1;
        }
        row += 1;
    }
    ioPrint("\033[0m");
    flushStdout();
}

